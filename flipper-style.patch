diff --git a/examples/factory/flipper_style.h b/examples/factory/flipper_style.h
new file mode 100644
index 0000000..627f4da
--- /dev/null
+++ b/examples/factory/flipper_style.h
@@ -0,0 +1,154 @@
+#pragma once
+
+// =============================================================================
+// Flipper Zero inspired visual style for the T-Embed CC1101 factory firmware.
+// Monochrome white/black UI with the signature Flipper orange accent.
+// =============================================================================
+
+#include <math.h>
+
+constexpr uint16_t kFlipperWhite   = 0xFFFF;
+constexpr uint16_t kFlipperBlack   = 0x0000;
+constexpr uint16_t kFlipperOrange  = 0xFC00;  // #FF8200 brand orange
+constexpr uint16_t kFlipperGray    = 0x7BEF;  // subtext
+constexpr uint16_t kFlipperGrayLt  = 0xC618;  // hairlines / scroll track
+constexpr uint16_t kFlipperPanel   = 0xF79E;  // barely-gray panel fill
+
+// Plots a thin arc (a0..a1 degrees, 0 = east, 90 = south) pixel by pixel.
+template <typename Canvas>
+void plotArc(Canvas& gfx, float cx, float cy, float r, float a0, float a1, uint16_t color)
+{
+    if (r <= 0.0f) {
+        return;
+    }
+    float step = 30.0f / r;  // keep pitch under ~0.5 px on the circumference
+    if (step < 1.0f) step = 1.0f;
+    if (step > 15.0f) step = 15.0f;
+    for (float a = a0; a <= a1; a += step) {
+        const float rad = a * 0.017453292519943295f;
+        gfx.drawPixel((int16_t)lroundf(cx + r * cosf(rad)),
+                      (int16_t)lroundf(cy + r * sinf(rad)),
+                      color);
+    }
+}
+
+// The Flipper dolphin, drawn from primitives. Facing right, Flipper style.
+// (cx, cy) = body center, s = unit scale in pixels (1 = tiny, 3 = hero size).
+template <typename Canvas>
+void drawFlipperDolphin(Canvas& gfx, int16_t cx, int16_t cy, int16_t s,
+                        uint16_t fg = kFlipperBlack, uint16_t bg = kFlipperWhite)
+{
+    if (s < 1) s = 1;
+
+    // Tail peduncle and flukes
+    gfx.fillTriangle(cx - 10 * s, cy - 3 * s, cx - 19 * s, cy - 2 * s, cx - 10 * s, cy + 3 * s, fg);
+    gfx.fillTriangle(cx - 17 * s, cy - 3 * s, cx - 24 * s, cy - 8 * s, cx - 19 * s, cy + 1 * s, fg);
+    gfx.fillTriangle(cx - 17 * s, cy + 1 * s, cx - 23 * s, cy + 6 * s, cx - 17 * s, cy + 4 * s, fg);
+
+    // Dorsal fin
+    gfx.fillTriangle(cx - 5 * s, cy - 6 * s, cx - 1 * s, cy - 13 * s, cx + 5 * s, cy - 6 * s, fg);
+
+    // Body, melon head and snout
+    gfx.fillEllipse(cx, cy, 13 * s, 8 * s, fg);
+    gfx.fillCircle(cx + 9 * s, cy - 2 * s, 6 * s, fg);
+    gfx.fillEllipse(cx + 14 * s, cy, 4 * s, 3 * s, fg);
+
+    // Pectoral fin
+    gfx.fillTriangle(cx + 2 * s, cy + 5 * s, cx + 7 * s, cy + 12 * s, cx + 10 * s, cy + 4 * s, fg);
+
+    // Eye (white with dark pupil and a tiny sparkle)
+    const int16_t eyeX = cx + 11 * s;
+    const int16_t eyeY = cy - 3 * s;
+    const int16_t eyeR = (s * 3) / 2 > 1 ? (s * 3) / 2 : 1;
+    gfx.fillCircle(eyeX, eyeY, eyeR, bg);
+    const int16_t pupilR = s / 2 > 0 ? s / 2 : 1;
+    gfx.fillCircle(eyeX + (s > 1 ? 1 : 0), eyeY, pupilR, fg);
+    if (s > 1) {
+        gfx.drawPixel(eyeX + s, eyeY - s, bg);  // sparkle
+    }
+
+    // Smile: a light arc carved into the head, plus a second pass for weight
+    const float smileR = 4.0f * s;
+    plotArc(gfx, (float)(cx + 10 * s), (float)(cy + 1 * s), smileR, 35.0f, 145.0f, bg);
+    if (s > 1) {
+        plotArc(gfx, (float)(cx + 10 * s), (float)(cy + 1 * s), smileR - 1.0f, 40.0f, 140.0f, bg);
+    }
+}
+
+// Flipper style 8x8 app icons, line-drawn. icon = page index (0..10).
+template <typename Canvas>
+void drawFlipperIcon(Canvas& gfx, uint8_t icon, int16_t x, int16_t y, uint16_t color)
+{
+    switch (icon) {
+        case 0:  // Battery / PMU
+            gfx.drawRect(x, y + 1, 6, 6, color);
+            gfx.fillRect(x + 6, y + 3, 2, 2, color);
+            gfx.fillRect(x + 1, y + 2, 2, 4, color);
+            gfx.fillRect(x + 3, y + 2, 2, 4, color);
+            break;
+        case 1:  // CC1101 sub-GHz radio: emitter
+            gfx.fillCircle(x + 4, y + 4, 1, color);
+            gfx.drawCircle(x + 4, y + 4, 3, color);
+            gfx.drawPixel(x + 1, y + 1, color);
+            gfx.drawPixel(x + 7, y + 1, color);
+            gfx.drawPixel(x + 1, y + 7, color);
+            gfx.drawPixel(x + 7, y + 7, color);
+            break;
+        case 2:  // IR remote
+            gfx.drawRoundRect(x + 2, y, 5, 8, 1, color);
+            gfx.fillCircle(x + 4, y + 2, 1, color);
+            gfx.drawFastHLine(x + 3, y + 4, 3, color);
+            gfx.drawFastHLine(x + 3, y + 6, 3, color);
+            break;
+        case 3:  // Microphone
+            gfx.fillRoundRect(x + 3, y, 3, 5, 1, color);
+            gfx.drawFastVLine(x + 2, y + 2, 4, color);
+            gfx.drawFastVLine(x + 6, y + 2, 4, color);
+            gfx.drawFastHLine(x + 2, y + 6, 5, color);
+            gfx.drawFastVLine(x + 4, y + 7, 1, color);
+            gfx.drawFastHLine(x + 3, y + 7, 3, color);
+            break;
+        case 4:  // NFC: waves opening to the right
+            plotArc(gfx, (float)(x + 1), (float)(y + 4), 2.0f, -55.0f, 55.0f, color);
+            plotArc(gfx, (float)(x + 1), (float)(y + 4), 4.0f, -55.0f, 55.0f, color);
+            plotArc(gfx, (float)(x + 1), (float)(y + 4), 6.0f, -55.0f, 55.0f, color);
+            break;
+        case 5:  // nRF24: antenna
+            gfx.drawFastVLine(x + 4, y + 3, 5, color);
+            gfx.fillCircle(x + 4, y + 2, 1, color);
+            plotArc(gfx, (float)(x + 4), (float)(y + 2), 3.0f, 200.0f, 340.0f, color);
+            break;
+        case 6:  // SD card
+            gfx.drawRect(x + 1, y, 5, 8, color);
+            gfx.drawFastVLine(x + 2, y + 1, 2, color);
+            gfx.drawFastVLine(x + 3, y + 1, 2, color);
+            gfx.drawFastVLine(x + 4, y + 1, 2, color);
+            break;
+        case 7:  // WiFi
+            gfx.fillCircle(x + 4, y + 5, 1, color);
+            plotArc(gfx, (float)(x + 4), (float)(y + 6), 3.0f, 220.0f, 320.0f, color);
+            plotArc(gfx, (float)(x + 4), (float)(y + 6), 4.6f, 230.0f, 310.0f, color);
+            break;
+        case 8:  // TFT display
+            gfx.drawRect(x, y + 1, 8, 5, color);
+            gfx.fillRect(x + 3, y + 6, 2, 1, color);
+            gfx.drawFastHLine(x + 2, y + 7, 4, color);
+            break;
+        case 9:  // WS2812 LED
+            gfx.drawCircle(x + 4, y + 4, 3, color);
+            gfx.fillCircle(x + 4, y + 4, 1, color);
+            break;
+        case 10:  // Settings gear
+        default: {
+            gfx.drawCircle(x + 4, y + 4, 2, color);
+            for (int a = 0; a < 360; a += 45) {
+                const float rad = a * 0.017453292519943295f;
+                const float c = cosf(rad), sn = sinf(rad);
+                gfx.drawLine((int16_t)lroundf(x + 4 + 2.5f * c), (int16_t)lroundf(y + 4 + 2.5f * sn),
+                             (int16_t)lroundf(x + 4 + 3.8f * c), (int16_t)lroundf(y + 4 + 3.8f * sn),
+                             color);
+            }
+            break;
+        }
+    }
+}
